{
  "name": "livery",
  "version": "0.1.0",
  "description": "A white-label React app where a brand is data: design tokens, one component library and many tenants.",
  "license": "MIT",
  "author": "Serge Tiutin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiutin/livery.git"
  },
  "homepage": "https://stiutin.github.io/livery/",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "design-tokens",
    "design-system",
    "white-label",
    "multi-tenant",
    "portfolio"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "apps/*",
    "themes/*"
  ],
  "scripts": {
    "dev": "npm -w apps/shell run dev",
    "build": "npm run build:themes && npm -w apps/shell run build",
    "build:themes": "npm -w themes/theme-tenant-alpha run build && npm -w themes/theme-tenant-beta run build",
    "test": "npm -w apps/shell run test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
