{
  "name": "white-label-multi-tenant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "themes/*"
  ],
  "scripts": {
    "dev": "npm -w apps/player-shell run dev",
    "build": "npm run build:themes && npm -w apps/player-shell run build",
    "build:themes": "npm -w themes/theme-tenant-alpha run build && npm -w themes/theme-tenant-beta run build",
    "test": "npm -w apps/player-shell run test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript-eslint": "^8.34.1"
  },
  "license": "ISC"
}
