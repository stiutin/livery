{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Alpha: deep violet with a cyan focus ring.",
  "primitive": {
    "color": {
      "$type": "color",
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9451, 0.9333, 0.9725],
          "hex": "#f1eef8"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9608, 0.9529, 1.0],
          "hex": "#f5f3ff"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3569, 0.1294, 0.7137],
          "alpha": 0.14,
          "hex": "#5b21b6"
        }
      },
      "border-strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5412, 0.498, 0.6392],
          "hex": "#8a7fa3"
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1176, 0.0784, 0.2],
          "hex": "#1e1433"
        }
      },
      "ink-muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3412, 0.302, 0.4196],
          "hex": "#574d6b"
        }
      },
      "brand-600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3569, 0.1294, 0.7137],
          "hex": "#5b21b6"
        }
      },
      "brand-700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.298, 0.1137, 0.5843],
          "hex": "#4c1d95"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0549, 0.4549, 0.5647],
          "hex": "#0e7490"
        }
      },
      "red": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.949, 0.949],
            "hex": "#fef2f2"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.7922, 0.7922],
            "hex": "#fecaca"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7255, 0.1098, 0.1098],
            "hex": "#b91c1c"
          }
        }
      },
      "green": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9412, 0.9922, 0.9569],
            "hex": "#f0fdf4"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7333, 0.9686, 0.8157],
            "hex": "#bbf7d0"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0824, 0.502, 0.2392],
            "hex": "#15803d"
          }
        }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": "{primitive.color.canvas}"
      },
      "surface": {
        "default": {
          "$value": "{primitive.color.white}"
        },
        "subtle": {
          "$value": "{primitive.color.subtle}"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.border}"
        },
        "strong": {
          "$value": "{primitive.color.border-strong}"
        }
      },
      "text": {
        "default": {
          "$value": "{primitive.color.ink}"
        },
        "muted": {
          "$value": "{primitive.color.ink-muted}"
        }
      },
      "brand": {
        "default": {
          "$value": "{primitive.color.brand-600}"
        },
        "hover": {
          "$value": "{primitive.color.brand-700}"
        },
        "on": {
          "$value": "{primitive.color.white}"
        }
      },
      "link": {
        "$value": "{primitive.color.brand-600}"
      },
      "focus": {
        "$value": "{primitive.color.focus}"
      },
      "danger": {
        "text": {
          "$value": "{primitive.color.red.700}"
        },
        "surface": {
          "$value": "{primitive.color.red.50}"
        },
        "border": {
          "$value": "{primitive.color.red.200}"
        }
      },
      "success": {
        "text": {
          "$value": "{primitive.color.green.700}"
        },
        "surface": {
          "$value": "{primitive.color.green.50}"
        },
        "border": {
          "$value": "{primitive.color.green.200}"
        }
      }
    }
  },
  "component": {
    "card": {
      "radius": {
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$type": "dimension"
      }
    }
  }
}
