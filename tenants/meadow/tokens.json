{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Meadow: bright and rounded. Teal on mint, pill buttons, soft corners.",
  "primitive": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8902, 0.9451, 0.9294],
          "hex": "#e3f1ed"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9608, 1.0, 0.9843],
          "hex": "#f5fffb"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8196, 0.9804, 0.898],
          "hex": "#d1fae5"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0784, 0.7216, 0.651],
          "alpha": 0.24,
          "hex": "#14b8a6"
        }
      },
      "border-strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3686, 0.549, 0.5098],
          "hex": "#5e8c82"
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0235, 0.3059, 0.2314],
          "hex": "#064e3b"
        }
      },
      "ink-muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2078, 0.3922, 0.3529],
          "hex": "#35645a"
        }
      },
      "brand": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.4627, 0.4314],
          "hex": "#0f766e"
        }
      },
      "brand-hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0667, 0.3686, 0.349],
          "hex": "#115e59"
        }
      },
      "on-brand": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "link": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0667, 0.3686, 0.349],
          "hex": "#115e59"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.4627, 0.4314],
          "hex": "#0f766e"
        }
      },
      "danger": {
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7255, 0.1098, 0.1098],
            "hex": "#b91c1c"
          }
        },
        "surface": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.949, 0.949],
            "hex": "#fef2f2"
          }
        },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.7922, 0.7922],
            "hex": "#fecaca"
          }
        }
      },
      "success": {
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0824, 0.502, 0.2392],
            "hex": "#15803d"
          }
        },
        "surface": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9412, 0.9922, 0.9569],
            "hex": "#f0fdf4"
          }
        },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7333, 0.9686, 0.8157],
            "hex": "#bbf7d0"
          }
        }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": "{primitive.color.canvas}"
      },
      "surface": {
        "default": {
          "$value": "{primitive.color.surface}"
        },
        "subtle": {
          "$value": "{primitive.color.subtle}"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.border}"
        },
        "strong": {
          "$value": "{primitive.color.border-strong}"
        }
      },
      "text": {
        "default": {
          "$value": "{primitive.color.ink}"
        },
        "muted": {
          "$value": "{primitive.color.ink-muted}"
        }
      },
      "brand": {
        "default": {
          "$value": "{primitive.color.brand}"
        },
        "hover": {
          "$value": "{primitive.color.brand-hover}"
        },
        "on": {
          "$value": "{primitive.color.on-brand}"
        }
      },
      "link": {
        "$value": "{primitive.color.link}"
      },
      "focus": {
        "$value": "{primitive.color.focus}"
      },
      "danger": {
        "text": {
          "$value": "{primitive.color.danger.text}"
        },
        "surface": {
          "$value": "{primitive.color.danger.surface}"
        },
        "border": {
          "$value": "{primitive.color.danger.border}"
        }
      },
      "success": {
        "text": {
          "$value": "{primitive.color.success.text}"
        },
        "surface": {
          "$value": "{primitive.color.success.surface}"
        },
        "border": {
          "$value": "{primitive.color.success.border}"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "small": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "medium": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "large": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    }
  },
  "component": {
    "button": {
      "radius": {
        "$value": {
          "value": 9999,
          "unit": "px"
        },
        "$type": "dimension"
      }
    }
  }
}
