{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Onyx: dark and premium. Warm gold on near-black, generous shadows.",
  "primitive": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0471, 0.0471, 0.0627],
          "hex": "#0c0c10"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0902, 0.0902, 0.1137],
          "hex": "#17171d"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1255, 0.1255, 0.1569],
          "hex": "#202028"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "alpha": 0.1,
          "hex": "#ffffff"
        }
      },
      "border-strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4431, 0.4431, 0.4784],
          "hex": "#71717a"
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9569, 0.9569, 0.9608],
          "hex": "#f4f4f5"
        }
      },
      "ink-muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6314, 0.6314, 0.6667],
          "hex": "#a1a1aa"
        }
      },
      "brand": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8314, 0.6627, 0.2902],
          "hex": "#d4a94a"
        }
      },
      "brand-hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.902, 0.7608, 0.451],
          "hex": "#e6c273"
        }
      },
      "on-brand": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0863, 0.0706, 0.0392],
          "hex": "#16120a"
        }
      },
      "link": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.902, 0.7608, 0.451],
          "hex": "#e6c273"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.902, 0.7608, 0.451],
          "hex": "#e6c273"
        }
      },
      "danger": {
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9882, 0.6471, 0.6471],
            "hex": "#fca5a5"
          }
        },
        "surface": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.1725, 0.0784, 0.0902],
            "hex": "#2c1417"
          }
        },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.498, 0.1137, 0.1137],
            "hex": "#7f1d1d"
          }
        }
      },
      "success": {
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5255, 0.9373, 0.6745],
            "hex": "#86efac"
          }
        },
        "surface": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0627, 0.149, 0.102],
            "hex": "#10261a"
          }
        },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0863, 0.3961, 0.2039],
            "hex": "#166534"
          }
        }
      },
      "overlay": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "alpha": 0.7,
          "hex": "#000000"
        }
      },
      "shadow": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "alpha": 0.5,
          "hex": "#000000"
        }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": "{primitive.color.canvas}"
      },
      "surface": {
        "default": {
          "$value": "{primitive.color.surface}"
        },
        "subtle": {
          "$value": "{primitive.color.subtle}"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.border}"
        },
        "strong": {
          "$value": "{primitive.color.border-strong}"
        }
      },
      "text": {
        "default": {
          "$value": "{primitive.color.ink}"
        },
        "muted": {
          "$value": "{primitive.color.ink-muted}"
        }
      },
      "brand": {
        "default": {
          "$value": "{primitive.color.brand}"
        },
        "hover": {
          "$value": "{primitive.color.brand-hover}"
        },
        "on": {
          "$value": "{primitive.color.on-brand}"
        }
      },
      "link": {
        "$value": "{primitive.color.link}"
      },
      "focus": {
        "$value": "{primitive.color.focus}"
      },
      "danger": {
        "text": {
          "$value": "{primitive.color.danger.text}"
        },
        "surface": {
          "$value": "{primitive.color.danger.surface}"
        },
        "border": {
          "$value": "{primitive.color.danger.border}"
        }
      },
      "success": {
        "text": {
          "$value": "{primitive.color.success.text}"
        },
        "surface": {
          "$value": "{primitive.color.success.surface}"
        },
        "border": {
          "$value": "{primitive.color.success.border}"
        }
      },
      "overlay": {
        "$value": "{primitive.color.overlay}"
      }
    },
    "font": {
      "family": {
        "body": {
          "$value": ["Avenir Next", "Avenir", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"],
          "$type": "fontFamily"
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "raised": {
        "$value": {
          "color": "{primitive.color.shadow}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 8,
            "unit": "px"
          },
          "blur": {
            "value": 24,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "overlay": {
        "$value": {
          "color": "{primitive.color.shadow}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 32,
            "unit": "px"
          },
          "blur": {
            "value": 64,
            "unit": "px"
          },
          "spread": {
            "value": -16,
            "unit": "px"
          }
        }
      }
    }
  }
}
