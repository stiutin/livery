{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The fallback brand: neutral greys and a calm blue.",
  "primitive": {
    "color": {
      "$type": "color",
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9294, 0.9412],
          "hex": "#ebedf0"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9451, 0.9608, 0.9765],
          "hex": "#f1f5f9"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "alpha": 0.12,
          "hex": "#000000"
        }
      },
      "border-strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4863, 0.5216, 0.5804],
          "hex": "#7c8594"
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.0902, 0.1647],
          "hex": "#0f172a"
        }
      },
      "ink-muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2941, 0.3333, 0.3882],
          "hex": "#4b5563"
        }
      },
      "brand-600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1451, 0.3882, 0.9216],
          "hex": "#2563eb"
        }
      },
      "brand-700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1137, 0.3059, 0.8471],
          "hex": "#1d4ed8"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1451, 0.3882, 0.9216],
          "hex": "#2563eb"
        }
      },
      "red": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.949, 0.949],
            "hex": "#fef2f2"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.7922, 0.7922],
            "hex": "#fecaca"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7255, 0.1098, 0.1098],
            "hex": "#b91c1c"
          }
        }
      },
      "green": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9412, 0.9922, 0.9569],
            "hex": "#f0fdf4"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7333, 0.9686, 0.8157],
            "hex": "#bbf7d0"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0824, 0.502, 0.2392],
            "hex": "#15803d"
          }
        }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": "{primitive.color.canvas}"
      },
      "surface": {
        "default": {
          "$value": "{primitive.color.white}"
        },
        "subtle": {
          "$value": "{primitive.color.subtle}"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.border}"
        },
        "strong": {
          "$value": "{primitive.color.border-strong}"
        }
      },
      "text": {
        "default": {
          "$value": "{primitive.color.ink}"
        },
        "muted": {
          "$value": "{primitive.color.ink-muted}"
        }
      },
      "brand": {
        "default": {
          "$value": "{primitive.color.brand-600}"
        },
        "hover": {
          "$value": "{primitive.color.brand-700}"
        },
        "on": {
          "$value": "{primitive.color.white}"
        }
      },
      "link": {
        "$value": "{primitive.color.brand-700}"
      },
      "focus": {
        "$value": "{primitive.color.focus}"
      },
      "danger": {
        "text": {
          "$value": "{primitive.color.red.700}"
        },
        "surface": {
          "$value": "{primitive.color.red.50}"
        },
        "border": {
          "$value": "{primitive.color.red.200}"
        }
      },
      "success": {
        "text": {
          "$value": "{primitive.color.green.700}"
        },
        "surface": {
          "$value": "{primitive.color.green.50}"
        },
        "border": {
          "$value": "{primitive.color.green.200}"
        }
      }
    }
  }
}
