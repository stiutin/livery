{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Harbour: light and minimal. Charcoal on paper, square corners, one quiet accent.",
  "primitive": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9569, 0.9569, 0.949],
          "hex": "#f4f4f2"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9412, 0.9412, 0.9294],
          "hex": "#f0f0ed"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1098, 0.098, 0.0902],
          "alpha": 0.12,
          "hex": "#1c1917"
        }
      },
      "border-strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4706, 0.4431, 0.4235],
          "hex": "#78716c"
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1098, 0.098, 0.0902],
          "hex": "#1c1917"
        }
      },
      "ink-muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3412, 0.3255, 0.3059],
          "hex": "#57534e"
        }
      },
      "brand": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1098, 0.098, 0.0902],
          "hex": "#1c1917"
        }
      },
      "brand-hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2667, 0.251, 0.2353],
          "hex": "#44403c"
        }
      },
      "on-brand": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "link": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1137, 0.3059, 0.8471],
          "hex": "#1d4ed8"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1137, 0.3059, 0.8471],
          "hex": "#1d4ed8"
        }
      },
      "danger": {
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7255, 0.1098, 0.1098],
            "hex": "#b91c1c"
          }
        },
        "surface": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.949, 0.949],
            "hex": "#fef2f2"
          }
        },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.7922, 0.7922],
            "hex": "#fecaca"
          }
        }
      },
      "success": {
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0824, 0.502, 0.2392],
            "hex": "#15803d"
          }
        },
        "surface": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9412, 0.9922, 0.9569],
            "hex": "#f0fdf4"
          }
        },
        "border": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7333, 0.9686, 0.8157],
            "hex": "#bbf7d0"
          }
        }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": "{primitive.color.canvas}"
      },
      "surface": {
        "default": {
          "$value": "{primitive.color.surface}"
        },
        "subtle": {
          "$value": "{primitive.color.subtle}"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.border}"
        },
        "strong": {
          "$value": "{primitive.color.border-strong}"
        }
      },
      "text": {
        "default": {
          "$value": "{primitive.color.ink}"
        },
        "muted": {
          "$value": "{primitive.color.ink-muted}"
        }
      },
      "brand": {
        "default": {
          "$value": "{primitive.color.brand}"
        },
        "hover": {
          "$value": "{primitive.color.brand-hover}"
        },
        "on": {
          "$value": "{primitive.color.on-brand}"
        }
      },
      "link": {
        "$value": "{primitive.color.link}"
      },
      "focus": {
        "$value": "{primitive.color.focus}"
      },
      "danger": {
        "text": {
          "$value": "{primitive.color.danger.text}"
        },
        "surface": {
          "$value": "{primitive.color.danger.surface}"
        },
        "border": {
          "$value": "{primitive.color.danger.border}"
        }
      },
      "success": {
        "text": {
          "$value": "{primitive.color.success.text}"
        },
        "surface": {
          "$value": "{primitive.color.success.surface}"
        },
        "border": {
          "$value": "{primitive.color.success.border}"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "small": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "medium": {
        "$value": {
          "value": 6,
          "unit": "px"
        }
      },
      "large": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      }
    }
  }
}
