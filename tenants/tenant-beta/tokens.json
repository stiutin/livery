{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Beta: teal on mint, with pill-shaped buttons.",
  "primitive": {
    "color": {
      "$type": "color",
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "mint": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9255, 0.9922, 0.9608],
          "hex": "#ecfdf5"
        }
      },
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8902, 0.9451, 0.9294],
          "hex": "#e3f1ed"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8196, 0.9804, 0.898],
          "hex": "#d1fae5"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0784, 0.7216, 0.651],
          "alpha": 0.24,
          "hex": "#14b8a6"
        }
      },
      "border-strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3686, 0.549, 0.5098],
          "hex": "#5e8c82"
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0235, 0.3059, 0.2314],
          "hex": "#064e3b"
        }
      },
      "ink-muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2078, 0.3922, 0.3529],
          "hex": "#35645a"
        }
      },
      "brand-600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.4627, 0.4314],
          "hex": "#0f766e"
        }
      },
      "brand-700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0667, 0.3686, 0.349],
          "hex": "#115e59"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0588, 0.4627, 0.4314],
          "hex": "#0f766e"
        }
      },
      "red": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.949, 0.949],
            "hex": "#fef2f2"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9961, 0.7922, 0.7922],
            "hex": "#fecaca"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7255, 0.1098, 0.1098],
            "hex": "#b91c1c"
          }
        }
      },
      "green": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9412, 0.9922, 0.9569],
            "hex": "#f0fdf4"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7333, 0.9686, 0.8157],
            "hex": "#bbf7d0"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0824, 0.502, 0.2392],
            "hex": "#15803d"
          }
        }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "canvas": {
        "$value": "{primitive.color.canvas}"
      },
      "surface": {
        "default": {
          "$value": "{primitive.color.mint}"
        },
        "subtle": {
          "$value": "{primitive.color.subtle}"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.border}"
        },
        "strong": {
          "$value": "{primitive.color.border-strong}"
        }
      },
      "text": {
        "default": {
          "$value": "{primitive.color.ink}"
        },
        "muted": {
          "$value": "{primitive.color.ink-muted}"
        }
      },
      "brand": {
        "default": {
          "$value": "{primitive.color.brand-600}"
        },
        "hover": {
          "$value": "{primitive.color.brand-700}"
        },
        "on": {
          "$value": "{primitive.color.white}"
        }
      },
      "link": {
        "$value": "{primitive.color.brand-700}"
      },
      "focus": {
        "$value": "{primitive.color.focus}"
      },
      "danger": {
        "text": {
          "$value": "{primitive.color.red.700}"
        },
        "surface": {
          "$value": "{primitive.color.red.50}"
        },
        "border": {
          "$value": "{primitive.color.red.200}"
        }
      },
      "success": {
        "text": {
          "$value": "{primitive.color.green.700}"
        },
        "surface": {
          "$value": "{primitive.color.green.50}"
        },
        "border": {
          "$value": "{primitive.color.green.200}"
        }
      }
    }
  },
  "component": {
    "button": {
      "radius": {
        "$value": {
          "value": 9999,
          "unit": "px"
        },
        "$type": "dimension"
      }
    },
    "card": {
      "radius": {
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$type": "dimension"
      }
    }
  }
}
