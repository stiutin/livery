{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4173/livery/",
        "http://localhost:4173/livery/harbour/en",
        "http://localhost:4173/livery/onyx/en/login",
        "http://localhost:4173/livery/meadow/de/theme/preview",
        "http://localhost:4173/livery/studio"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 1}],
        "categories:best-practices": ["error", {"minScore": 1}],
        "categories:seo": ["error", {"minScore": 1}],
        "categories:performance": ["error", {"minScore": 0.9}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.02}],
        "largest-contentful-paint": ["warn", {"maxNumericValue": 2500}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
